*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f8f3eb;
    color:#2e241b;
    font-family:'Libre Baskerville',serif;
    line-height:1.8;
}

header{
    position:fixed;
    top:0;
    width:100%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 10%;
    background:rgba(248,243,235,.95);
    backdrop-filter:blur(10px);
    border-bottom:1px solid #d8c7a8;
    z-index:1000;
}

.logo{
    font-family:'Cormorant Garamond',serif;
    font-size:32px;
    font-weight:700;
    letter-spacing:1px;
}

nav a{
    color:#3c2f24;
    text-decoration:none;
    margin-left:25px;
    transition:.3s;
}

nav a:hover{
    color:#8b5e3c;
}

.hero{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:120px 20px 60px;
    background:linear-gradient(rgba(248,243,235,.92),rgba(248,243,235,.95)),
    url("https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1400&q=80");
    background-size:cover;
    background-position:center;
}

.hero-content{
    max-width:850px;
}

.small-text{
    text-transform:uppercase;
    letter-spacing:4px;
    color:#7a6753;
    margin-bottom:20px;
}

.hero h1{
    font-family:'Cormorant Garamond',serif;
    font-size:72px;
    margin-bottom:25px;
}

.intro{
    font-size:20px;
    color:#56483d;
    margin-bottom:40px;
}

.button{
    display:inline-block;
    padding:15px 35px;
    background:#4b3621;
    color:white;
    text-decoration:none;
    border-radius:40px;
    transition:.3s;
}

.button:hover{
    background:#6d4c2f;
    transform:translateY(-2px);
}

section{
    width:90%;
    max-width:1100px;
    margin:auto;
    padding:100px 0;
}

section h2{
    font-family:'Cormorant Garamond',serif;
    font-size:50px;
    margin-bottom:30px;
    text-align:center;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:30px;
}

.card{
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
}

.card h3{
    font-family:'Cormorant Garamond',serif;
    margin-bottom:15px;
    font-size:30px;
}

#library ul{
    list-style:none;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:18px;
}

#library li{
    background:#fff;
    padding:16px;
    border-left:5px solid #8b5e3c;
    border-radius:8px;
}

footer{
    text-align:center;
    padding:40px;
    border-top:1px solid #d8c7a8;
    font-style:italic;
    color:#6d5b4d;
}

@media(max-width:768px){

header{
    flex-direction:column;
    gap:15px;
}

nav{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
}

.hero h1{
    font-size:52px;
}

section h2{
    font-size:40px;
}

.intro{
    font-size:18px;
}

}
